# ========================================
# Ambigo Postgres — Local Development
# ========================================
# Copy to .env or set DATABASE_URL directly.
# Local docker-compose default:
DATABASE_URL=postgres://ambigo:ambigo_dev_password@localhost:5432/ambigo?sslmode=disable

# Pool tuning (optional, defaults shown)
PG_MAX_OPEN_CONNS=25
PG_MAX_IDLE_CONNS=5
PG_MAX_CONN_LIFETIME=5m
PG_MAX_CONN_IDLE_TIME=2m

# For Neon later (example):
# DATABASE_URL=postgres://user:pass@ep-xxx.neon.tech/ambigo?sslmode=require
